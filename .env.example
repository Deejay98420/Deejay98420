# PandaBrain Desk configuration. Copy to .env (setup.sh does this). Never commit .env.
# Everything here is optional. The desk runs in RULES mode with public data and no keys.

# Solana RPC endpoint. Defaults to the public mainnet endpoint (rate limited).
# Paid RPC URLs often embed a key; the desk only ever displays the host.
SOLANA_RPC_URL=

# TYPED_AI judge (optional). Key stays server-side; it is never sent to the browser.
# Without it, selecting TYPED_AI leaves the judge visibly UNCONFIGURED (no fallback to RULES).
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Telegram notifications (optional, opt-in). All three are required to send anything.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PANDABRAIN_TELEGRAM_OPT_IN=0

# Server binding. Localhost only unless PANDABRAIN_ALLOW_REMOTE=1 (not recommended).
PANDABRAIN_HOST=127.0.0.1
PANDABRAIN_PORT=8765
# PANDABRAIN_DATA_DIR=./data
