# pandarianz-solana-hybrid-sniper — PAPER ONLY. Copy to .env and fill in. Never commit .env.
# There is deliberately NO wallet / private-key setting: this system cannot sign or send transactions.

# PostgreSQL (docker compose default; matches docker-compose.yml)
DATABASE_URL=postgres://sniper:sniper@127.0.0.1:55432/sniper

# ---- Live market data (read-only) ---------------------------------------------------------
# One or more provider WebSocket URLs, comma-separated. All run concurrently; duplicates are
# dropped and the feed stays HEALTHY while any provider delivers (failover). Paid URLs often embed
# a key; only scheme://host is ever logged or shown.
SOLANA_WS_URLS=<wss://your-provider-1/?api-key=...>,<wss://your-provider-2/...>
# Read-only JSON-RPC endpoints for getTransaction / getSignaturesForAddress / getAccountInfo.
# Leave empty to derive https:// URLs from the WebSocket URLs (works for most providers).
SOLANA_RPC_URLS=
# logs = logsSubscribe on any RPC (PumpSwap events are fetched with getTransaction)
# transactions = transactionSubscribe (providers that support it; no extra fetch needed)
SOLANA_STREAM_KIND=logs
# 1 = also subscribe to slotsUpdatesSubscribe for dead-slot (fork) notifications, if supported
SOLANA_SLOT_UPDATES=0
SOLANA_RPC_RATE_PER_S=10
TX_FETCH_CONCURRENCY=8
# Startup backfill so tokens launched before startup can be evaluated (0 disables)
BACKFILL_MAX_SIGNATURES=300
BACKFILL_MAX_AGE_S=900

# ---- Jupiter quotes (read-only GET quote; LIVE mode only) ---------------------------------
# Full quote URL of the Swap API version you use, e.g. <https://.../swap/v1/quote>
JUPITER_QUOTE_URL=
JUPITER_API_KEY=
JUPITER_RATE_PER_S=1

# Engine API for the dashboard (read-only, GET only). Bind to localhost.
SNIPER_API_ADDR=127.0.0.1:8787
# Optional strategy/cost overrides
SNIPER_CONFIG=config/strategy.toml
RUST_LOG=info
