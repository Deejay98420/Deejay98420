# pandarianz-solana-hybrid-sniper — PAPER ONLY. Copy to .env and fill in. Never commit .env.
# There is deliberately NO wallet / private-key setting: this system cannot sign or send transactions.

# PostgreSQL (docker compose default; matches docker-compose.yml)
DATABASE_URL=postgres://sniper:sniper@127.0.0.1:55432/sniper

# Live market data (optional). Standard Solana JSON-RPC WebSocket endpoint of your provider.
# Paid endpoints often embed a key in the URL; it is only ever logged as scheme://host.
SOLANA_WS_URL=
# logs (any RPC: sees Pump.fun bonding-curve events only) | transactions (providers supporting
# transactionSubscribe with jsonParsed: also sees PumpSwap emit_cpi events)
SOLANA_STREAM_KIND=logs
SOLANA_PROVIDER_NAME=rpc-ws

# Jupiter quote endpoint (read-only GET quote; used in LIVE mode only, for route coverage and
# exit fallback). Set the full quote URL of the Swap API version you use, e.g. <https://.../quote>
JUPITER_QUOTE_URL=
JUPITER_API_KEY=
JUPITER_RATE_PER_S=1

# Engine API for the dashboard (read-only, GET only). Bind to localhost.
SNIPER_API_ADDR=127.0.0.1:8787
# Optional strategy/cost overrides
SNIPER_CONFIG=config/strategy.toml
RUST_LOG=info
